# Keep source and configuration diffs stable across Windows, macOS, and Linux.
* text=auto

*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
